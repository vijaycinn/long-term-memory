    "vault": {
      "tools": [
        "*"
      ],
      "type": "stdio",
      "command": "python",
      "args": [
        "C:\\workspace\\agency\\long-term-memory\\wiki\\vault_mcp.py"
      ]
    },
    "WebIQ-MCP": {
      "tools": [
        "*"
      ],
      "type": "stdio",
      "command": "node",
      "args": [
        "C:\\Users\\vcinnakonda\\.copilot\\webiq-mcp-proxy.cjs"
      ],
      "env": {
