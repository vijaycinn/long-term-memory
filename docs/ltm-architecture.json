  "cards": [
    {
      "dot": "emerald",
      "title": "Sub-5ms Turn-Zero Memory (L1 Cache)",
      "items": [
        "Fair Topic-Quota compiler enforces an O(1) context ceiling (max 40 facts / ~1.5k tokens)",
        "Pre-compiled L1 bridge loads in under 5 ms without blocking startup or burning extra tokens",
        "Eliminates cold-start amnesia and prevents noisy topics from crowding out critical rules"
      ]
    },
    {
      "dot": "cyan",
      "title": "Local Dual-Engine & Offline Resilience",
      "items": [
        "Primary memory.db is 100% local SQLite + FTS5 with zero external dependencies",
        "Derivative sidecar BM25 indexes chunks locally for instant exact-keyword hits (16ms)",
        "Fully functional offline without cloud connectivity, API tokens, or pip installs"
      ]
    },
    {
      "dot": "violet",
      "title": "Hybrid Semantic Retrieval (L2 Store)",
      "items": [
        "Azure OpenAI text-embedding-3-small generates 512-dim vectors into sqlite-vec",
        "Sidecar database stays decoupled from memory.db to prevent backup bloat",
        "Reciprocal Rank Fusion (RRF) blends keyword precision with conceptual semantic search"
      ]
    }
  ]
